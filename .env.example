NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Use the local anon key printed by `pnpm exec supabase status`; never use production credentials.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Auth remains the OAuth/session provider for Google and GitHub.
NEXT_PUBLIC_AUTH_PROVIDER=supabase
# Local API origin:
# API_URL=http://localhost:4012
# Production origins (Vercel):
# Server-only API origin. Browser requests remain same-origin through middleware.
API_URL=https://api.commitdiary.dev
# Server-only shared auth rate-limit credential; never expose as NEXT_PUBLIC_*.
AUTH_RATE_LIMIT_SECRET=
# Public origins for host-aware routing. Include the scheme and omit trailing paths.
NEXT_PUBLIC_MARKETING_URL=https://commitdiary.dev
NEXT_PUBLIC_APP_URL=https://app.commitdiary.dev
NEXT_PUBLIC_GITHUB_URL=https://github.com/commitdiary
# Use polling to keep product data independent from Supabase Realtime. Messages
# are notifications only; the API remains the source of truth.
NEXT_PUBLIC_REALTIME_PROVIDER=polling
# Public destinations used by landing-page links and metadata.
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.visualstudio.com/items?itemName=samuel-adedigba.commitdiary-extension
NEXT_PUBLIC_DOCS_URL=https://app.commitdiary.dev/documentation
NEXT_PUBLIC_DISCORD_DOCS_URL=https://app.commitdiary.dev/documentation#discord

# Public legal identity and contact details. Set the verified legal entity and
# registered/principal address before Paddle domain review and live billing.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Safe-to-publish Paddle.js token for localized pricing previews only.
# It also opens server-created transaction links on /checkout?_ptxn=...
# Use test_... with the sandbox environment and live_... only in production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Profile media can remain on Supabase Storage until an S3-compatible bucket is
# configured. Set STORAGE_PROVIDER=s3 only after all S3 values are present.
# STORAGE_PROVIDER=supabase
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Development overrides:
# NEXT_PUBLIC_MARKETING_URL=http://localhost:4011
# NEXT_PUBLIC_APP_URL=http://localhost:4011
