NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Use the local anon key printed by `pnpm exec supabase status`; never use production credentials.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local API origin:
# API_URL=http://localhost:3001
# Production origins (Vercel):
# Server-only API origin. Browser requests remain same-origin through middleware.
API_URL=https://api.commitdiary.dev
# Public origins for host-aware routing. Include the scheme and omit trailing paths.
NEXT_PUBLIC_MARKETING_URL=https://commitdiary.dev
NEXT_PUBLIC_APP_URL=https://app.commitdiary.dev
# Public destinations used by landing-page links and metadata.
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.visualstudio.com/items?itemName=samuel-adedigba.commitdiary-extension
NEXT_PUBLIC_DOCS_URL=https://app.commitdiary.dev/documentation
NEXT_PUBLIC_DISCORD_DOCS_URL=https://app.commitdiary.dev/documentation#discord

# Public legal identity and contact details. Set the verified legal entity and
# registered/principal address before Paddle domain review and live billing.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Development overrides:
# NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
